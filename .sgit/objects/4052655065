void get_hash_root_tree(char *rootTree)
{
	FILE *f = fopen(".sgit/HEAD", "r");
	if(f == NULL) return;
	char commitHash[11];
	int result = fscanf(f, "%s", commitHash);
	if(result != 1)
	{
		fclose(f);
		return;
	}
	fclose(f);

	size_t bufferSize = strlen(".sgit/objects/") + strlen(commitHash) + 1;
	char *buffer = malloc(bufferSize);
	if(buffer == NULL) return;
	int res = snprintf(buffer, bufferSize, ".sgit/objects/%s", commitHash);
	if(res >= bufferSize)
	{
		free(buffer);
		return;
	}

	FILE *fp = fopen(buffer, "r");
	free(buffer);
	if(fp == NULL) return;	
	char rootTreeBuffer[32];
	if(fgets(rootTreeBuffer, sizeof(rootTreeBuffer), fp) == NULL);
	{
		fclose(fp);
		return;
	}
	int j = 0;
	for(int i = 0; i < strlen(rootTreeBuffer); i++)
	{
		if(rootTreeBuffer[i] >= '0' && rootTreeBuffer[i] <= '9')
			rootTree[j++] = rootTreeBuffer[i];
	}
	rootTree[j] = '\0';
	fclose(fp);
}

void load_tree(char *currentTree, nod *tree)
{
	size_t size = strlen(".sgit/objects/") + strlen(currentTree) + 1;
	char *buffer = malloc(size);
	snprintf(buffer, size, ".sgit/objects/%s", currentTree);
	FILE *f = fopen(buffer, "r");
	if(f == NULL)
	{
		free(buffer);
		return;
	}	
	free(buffer);
	char *lineBuffer = NULL;
	size_t lineSize = 0;
	while(getline(&lineBuffer, &lineSize, f) != -1)
	{
		lineBuffer[strcspn(lineBuffer, "\r\n")] = '\0';

		char *type_t = strtok(lineBuffer, " ");
		char *hash_t = strtok(NULL, " ");
		char *name_t = strtok(NULL, " ");
		if(type_t == NULL || hash_t == NULL || name_t == NULL) continue;
		nod *p = calloc(1, sizeof(struct nod));
		if(strcmp(type_t, "blob") == 0)
		{
			p->type = BLOB;
			p->hash = string_to_int_hash(hash_t);
			p->name = strdup(name_t);
			p->next = NULL;
			p->data.file = NULL;
			directory_concatenation(p, tree);
		}
		else if(strcmp(type_t, "tree") == 0)
		{
			p->type = TREE;
			p->hash = string_to_int_hash(hash_t);
			p->name = strdup(name_t);
			p->next = NULL;
			p->data.entry = NULL;
			load_tree(hash_t, p);
			directory_concatenation(p, tree);
		}
	}
	free(lineBuffer);
	fclose(f);
}

nod *create_temp_tree(char *currentTree)
{
	nod * tree = calloc(1, sizeof(struct nod));
 	tree->data.entry = NULL;
	tree->hash = string_to_int_hash(currentTree);
	tree->next = NULL;
	char *path = getcwd(NULL, 0);
	tree->name = get_head_name(path);
	free(path);
	tree->type = TREE;
	load_tree(currentTree, tree);
	return tree;
}

nod *search(nod *p, char *name)
{
	for(nod *c = p; c != NULL; c = c->next)
		if(strcmp(c->name, name) == 0)
			return c;
	return NULL;
}

void view_disk_tree(nod *p, char *path, nod *temp_tree)
{
	if(p == NULL) return;
	size_t bufferSize;
	if(strlen(path) > 0)
		bufferSize = strlen(path) + 1 + strlen(p->name) + 1;
	else 
		bufferSize = strlen(p->name) + 1;
	char *buffer = malloc(bufferSize);
	if(strlen(path) > 0)
		snprintf(buffer, bufferSize, "%s/%s", path, p->name); 
	else
		snprintf(buffer, bufferSize, "%s",  p->name); 
	nod *temp;
	temp = search(temp_tree, p->name);
	if(temp == NULL)
		printf("File: %s untracked\n", buffer);
	else if(p->type != temp->type)
	{
		if(p->type == BLOB)
			printf("File: %s changed into directory\n", buffer);
		else if(p->type == TREE)
			printf("Directory: %s changed into file\n", buffer);

	}
	else if(p->type == BLOB && temp->type == TREE)
	{
		if(p->hash != temp->hash)
			printf("File: %s modified\n", buffer);
	}
	else if(p->type == TREE && temp->type == TREE)
	{
		if(p->data.entry != NULL)
		{
			if(temp == NULL)
				view_disk_tree(p->data.entry, buffer, NULL);
			else
				view_disk_tree(p->data.entry, buffer, temp->data.entry);
		}
	}
	if(p->next != NULL) view_disk_tree(p->next, path, temp_tree);
	free(buffer);
}
void view_temp_tree(nod *p, char *path, nod *temp_tree)
{
	if(p == NULL) return;
	size_t bufferSize;
	if(strlen(path) > 0)
		bufferSize = strlen(path) + 1 + strlen(p->name) + 1;
	else 
		bufferSize = strlen(p->name) + 1;
	char *buffer = malloc(bufferSize);
	if(strlen(path) > 0)
		snprintf(buffer, bufferSize, "%s/%s", path, p->name); 
	else
		snprintf(buffer, bufferSize, "%s",  p->name); 
	nod *temp;
	temp = search(temp_tree, p->name);
	if(p->type == BLOB && temp->type == BLOB)
	{
		if(temp == NULL)
			printf("File: %s deleted\n", buffer);
	}
	else if(p->type == TREE && temp->type == TREE)
	{
		if(p->data.entry != NULL)
		{
			if(temp == NULL)
				view_temp_tree(p->data.entry, buffer, NULL);
			else
				view_temp_tree(p->data.entry, buffer, temp->data.entry);
		}
	}
	if(p->next != NULL) view_temp_tree(p->next, path, temp_tree);
	free(buffer);
}


void get_diff(nod *disk_tree, nod *temp_tree)
{
	if(disk_tree->hash != temp_tree->hash)
	{
		view_disk_tree(disk_tree->data.entry, "", temp_tree->data.entry);
		view_temp_tree(temp_tree->data.entry, "", disk_tree->data.entry);
	}

}


